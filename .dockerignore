.wwebjs_auth/
.wwebjs_cache/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker (avoid recursive copies)
Dockerfile*
docker-compose*
.dockerignore

# Git
.git/
.gitignore

# Documentation images (not needed at runtime)
*.png
*.jpg
*.jpeg
*.gif
