# Configuración del servidor
PORT=6900

# Configuración de Redis
# Para Docker Compose: REDIS_HOST=redis
# Para ejecución local: REDIS_HOST=localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Configuración de Puppeteer / Chromium (Docker)
# Estas variables ya están definidas en docker-compose.yml.
# Descomenta y ajusta solo si ejecutas fuera de Docker con un Chromium personalizado.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Configuración de WhatsApp
# No requiere configuración adicional por ahora